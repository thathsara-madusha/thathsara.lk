---
import { toDateLabel } from "@/lib/utils.js";
import UnreadBadge from "../reader/UnreadBadge.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;

const tags = post.data.tags ?? [];
const rawExcerpt =
  post.data.excerpt ??
  post.body
    ?.replace(/^---[\s\S]*?---/, "")
    .replace(/import\s+.*?from\s+['"].*?['"]/gm, "")
    .replace(/<[^>]+>/g, "")
    .replace(/[#*`_[\]]/g, "")
    .replace(/\s+/g, " ")
    .trim() ?? "";
const excerpt =
  rawExcerpt.length > 200 ? rawExcerpt.slice(0, 200).trimEnd() + "…" : rawExcerpt;

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readMinutes = Math.max(1, Math.round(wordCount / 200));
const readTime = `${readMinutes} min`;

const searchText = [post.data.title, excerpt, ...tags].join(" ").toLowerCase();
---

<article
  class="post-card"
  data-search={searchText}
  data-search-item
  data-search-kind="archive"
  data-post-id={post.id}
>
  <div class="post-meta">
    <time class="post-date" datetime={post.data.date.toISOString()}>{toDateLabel(post.data.date)}</time>
    <UnreadBadge postId={post.id} />
    {tags.map((tag) => (
      <a class="post-tag" href={`/tags/${tag}/`}>{tag}</a>
    ))}
    <span class="post-read-time">{readTime} read</span>
  </div>
  <a class="post-card-link" href={`/posts/${post.id}/`}>
    <h3 class="post-title">{post.data.title}</h3>
    {excerpt && <p class="post-excerpt-text">{excerpt}</p>}
  </a>
</article>
